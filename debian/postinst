#!/bin/sh
set -e

# returns 0 if running in chroot, 1 if not
running_in_chroot() {
    if [ "${SYSTEMD_IGNORE_CHROOT:-0}" = "1" ]; then
        return 1
    fi

    if [ -e "/proc/1/root" ]; then
        root_dev_ino=$(stat -c '%d:%i' / 2>/dev/null) || return 0
        proc1_root_dev_ino=$(stat -L -c '%d:%i' /proc/1/root 2>/dev/null) || return 0

        [ "$root_dev_ino" = "$proc1_root_dev_ino" ] && return 1 || return 0
    fi

    if [ ! -d "/proc" ] || [ ! -r "/proc/version" ]; then
        [ "$$" = "1" ] && return 1 || return 0
    fi

    return 0
}

case "$1" in
configure)
    target=""
    if grep -q 'Spacemit(R) X100' /proc/cpuinfo; then
        target="spacemit"
    else
        echo "Running not in Spacemit X100, skipping install EDK2 to bootloader partition."
        exit 0
    fi

    if running_in_chroot; then
        echo "Running in chroot, skipping install EDK2 to bootloader partition."
        exit 0
    fi

    # 检测是否为UEFI启动
    IS_UEFI=1
    if [ ! -d "/sys/firmware/efi" ]; then
        IS_UEFI=0
        echo "NOT UEFI boot, skipping UEFI firmware installation."
        exit 0
    fi

    # 解析 /proc/mtd 判断分区布局
    if [ ! -f "/proc/mtd" ]; then
        echo "Error: /proc/mtd not found, cannot determine MTD partition layout"
        exit 0
    fi

    # 获取 mtd0 的名称
    MTD0_NAME=$(grep '^mtd0:' /proc/mtd | awk -F'"' '{print $2}')

    if [ "$MTD0_NAME" = "bootinfo" ]; then
        # mtd0 是 bootinfo，说明各组件有独立分区，按分区编号写入
        EDK2=/dev/mtdblock5
        # 以KB为单位
        EDK2_SEEK=0
    else
        # mtd0 是整个设备，使用偏移方式写入
        echo "Detected MTD partition layout: single device with offsets (mtd0=$MTD0_NAME)"
        EDK2=/dev/mtdblock0
        # 以KB为单位
        EDK2_SEEK=2112
    fi

    BIN_DIR="/usr/lib/uefi/$target"
    # 待检查文件列表
    files="${BIN_DIR}/edk2.itb"

    for file in $files; do
        if [ ! -e "$file" ]; then
            # 任意不存在则退出
            echo "Missing $file"
            exit 0
        fi
    done

    # 此前已经做了所有检查
    set -x
    dd if=${BIN_DIR}/edk2.itb of=$EDK2 seek=$EDK2_SEEK bs=1K && sync
    set +x
    ;;
esac

exit 0
