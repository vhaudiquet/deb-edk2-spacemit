#!/bin/sh
set -e

# returns 0 if running in chroot, 1 if not
running_in_chroot() {
    if [ "${SYSTEMD_IGNORE_CHROOT:-0}" = "1" ]; then
        return 1
    fi

    if [ -e "/proc/1/root" ]; then
        root_dev_ino=$(stat -c '%d:%i' / 2>/dev/null) || return 0
        proc1_root_dev_ino=$(stat -L -c '%d:%i' /proc/1/root 2>/dev/null) || return 0

        [ "$root_dev_ino" = "$proc1_root_dev_ino" ] && return 1 || return 0
    fi

    if [ ! -d "/proc" ] || [ ! -r "/proc/version" ]; then
        [ "$$" = "1" ] && return 1 || return 0
    fi

    return 0
}

case "$1" in
configure)
    target=""
    # Detect a Spacemit K3 / X100 platform.  Different kernels expose the SoC
    # identity differently, so accept any of:
    #   - "Spacemit(R) X100" model string in /proc/cpuinfo (older kernels)
    #   - "spacemit,x100" uarch line in /proc/cpuinfo (newer kernels)
    #   - "spacemit,k3" in /proc/device-tree/compatible (device tree)
    if grep -q 'Spacemit(R) X100' /proc/cpuinfo \
        || grep -q 'spacemit,x100' /proc/cpuinfo \
        || { [ -r /proc/device-tree/compatible ] &&
             grep -qa 'spacemit,k3' /proc/device-tree/compatible; }; then
        target="spacemit"
    else
        echo "Running not in Spacemit K3/X100, skipping install EDK2 to bootloader partition."
        exit 0
    fi

    if running_in_chroot; then
        echo "Running in chroot, skipping install EDK2 to bootloader partition."
        exit 0
    fi

    # Check whether booting via UEFI
    IS_UEFI=1
    if [ ! -d "/sys/firmware/efi" ]; then
        IS_UEFI=0
        echo "NOT UEFI boot, skipping UEFI firmware installation."
        exit 0
    fi

    # Parse /proc/mtd to determine the partition layout
    if [ ! -f "/proc/mtd" ]; then
        echo "Error: /proc/mtd not found, cannot determine MTD partition layout"
        exit 0
    fi

    # Ensure mtdblock is loaded.  It is built-in on SpacemiT kernels but
    # ships as a module on mainline kernels (e.g. Ubuntu), where /dev/mtdblock*
    # won't exist until the module is loaded.
    modprobe mtdblock 2>/dev/null || true

    # Get the name of mtd0
    MTD0_NAME=$(grep '^mtd0:' /proc/mtd | awk -F'"' '{print $2}')

    if [ "$MTD0_NAME" = "bootinfo" ]; then
        # mtd0 is bootinfo, meaning each component has its own partition; write by partition number
        EDK2=/dev/mtdblock5
        # In KB units
        EDK2_SEEK=0
    else
        # mtd0 is the whole device; write using an offset
        echo "Detected MTD partition layout: single device with offsets (mtd0=$MTD0_NAME)"
        EDK2=/dev/mtdblock0
        # In KB units
        EDK2_SEEK=2112
    fi

    BIN_DIR="/usr/lib/uefi/$target"
    # List of files to check
    files="${BIN_DIR}/edk2.itb"

    for file in $files; do
        if [ ! -e "$file" ]; then
            # Exit if any file is missing
            echo "Missing $file"
            exit 0
        fi
    done

    # All checks have already been performed above
    if [ ! -b "$EDK2" ]; then
        echo "Error: $EDK2 block device not found (mtdblock not available in this kernel?)"
        exit 0
    fi

    set -x
    dd if=${BIN_DIR}/edk2.itb of=$EDK2 seek=$EDK2_SEEK bs=1K && sync
    set +x
    ;;
esac

exit 0
